rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }

    function isSignedIn() { 
      return request.auth != null && request.auth.token.email_verified == true; 
    }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidWorkGroup(data) {
      return data.keys().hasOnly(['name']) &&
             data.keys().size() >= 1 &&
             data.name is string && data.name.size() <= 100;
    }

    function isValidEmployee(data) {
      return data.keys().hasOnly(['name', 'firstName', 'lastName', 'role', 'phone', 'workGroup', 'workGroupId']) &&
             data.name is string && data.name.size() <= 100 &&
             data.role in ['Conductor', 'Ayudante', 'Coordinador'] &&
             data.phone is string && data.phone.size() <= 20 &&
             data.get('workGroup', '') is string && data.get('workGroup', '').size() <= 100 &&
             data.get('workGroupId', '') is string && data.get('workGroupId', '').size() <= 128 &&
             data.get('firstName', '') is string && data.get('firstName', '').size() <= 50 &&
             data.get('lastName', '') is string && data.get('lastName', '').size() <= 50;
    }

    function isValidVehicle(data) {
      return data.keys().hasOnly(['plate', 'internalNumber', 'capacity', 'status', 'workGroupId']) &&
             data.plate is string && data.plate.size() <= 20 &&
             data.internalNumber is string && data.internalNumber.size() <= 50 &&
             data.capacity is number &&
             data.status in ['Operativo', 'Inoperativo'] &&
             data.get('workGroupId', '') is string && data.get('workGroupId', '').size() <= 128;
    }

    function isValidRoute(data) {
      return data.keys().hasOnly(['name', 'code', 'operatingDays', 'origin', 'destination', 'estimatedHours', 'workGroupId', 'firstName', 'lastName']) &&
             data.name is string && data.name.size() <= 100 &&
             data.code is string && data.code.size() <= 50 &&
             data.operatingDays is list && data.operatingDays.size() <= 7 &&
             data.origin is string && data.origin.size() <= 100 &&
             data.destination is string && data.destination.size() <= 100 &&
             data.estimatedHours is number &&
             data.get('workGroupId', '') is string && data.get('workGroupId', '').size() <= 128 &&
             data.get('firstName', '') is string && data.get('firstName', '').size() <= 50 &&
             data.get('lastName', '') is string && data.get('lastName', '').size() <= 50;
    }

    function isValidIncident(data) {
      return data.keys().hasOnly(['id', 'timestamp', 'type', 'description', 'startTime', 'endTime']) &&
             data.id is string && data.id.size() <= 128 &&
             data.timestamp is string && data.timestamp.size() <= 50 &&
             data.type in ['Retraso', 'Mecánico', 'Personal', 'Clima', 'Otro'] &&
             data.description is string && data.description.size() <= 500 &&
             data.get('startTime', '') is string && data.get('startTime', '').size() <= 50 &&
             data.get('endTime', '') is string && data.get('endTime', '').size() <= 50;
    }

    function isValidAssignment(data) {
      return data.keys().hasOnly(['routeId', 'vehicleId', 'employeeIds', 'date', 'status', 'incidents', 'workGroupId']) &&
             data.routeId is string && data.routeId.size() <= 128 &&
             data.vehicleId is string && data.vehicleId.size() <= 128 &&
             data.employeeIds is list && data.employeeIds.size() <= 10 &&
             data.date is string && data.date.size() <= 50 &&
             data.status in ['Pendiente', 'Salida de Base', 'Inicio de Ruta', 'Fin de Ruta', 'Relleno', 'Base', 'Cancelado'] &&
             data.incidents is list && data.incidents.size() <= 50 &&
             data.get('workGroupId', '') is string && data.get('workGroupId', '').size() <= 128;
    }

    function isValidCrew(data) {
      return data.keys().hasOnly(['name', 'driverId', 'assistantIds', 'workGroupId', 'firstName', 'lastName']) &&
             data.name is string && data.name.size() <= 100 &&
             data.driverId is string && data.driverId.size() <= 128 &&
             data.assistantIds is list && data.assistantIds.size() <= 5 &&
             data.get('workGroupId', '') is string && data.get('workGroupId', '').size() <= 128 &&
             data.get('firstName', '') is string && data.get('firstName', '').size() <= 50 &&
             data.get('lastName', '') is string && data.get('lastName', '').size() <= 50;
    }

    match /workGroups/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(id) && isValidWorkGroup(incoming());
      allow update: if isSignedIn() && isValidId(id) && isValidWorkGroup(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['name']);
      allow delete: if isSignedIn() && isValidId(id);
    }
    match /employees/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(id) && isValidEmployee(incoming());
      allow update: if isSignedIn() && isValidId(id) && isValidEmployee(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'firstName', 'lastName', 'role', 'phone', 'workGroup', 'workGroupId']);
      allow delete: if isSignedIn() && isValidId(id);
    }
    match /vehicles/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(id) && isValidVehicle(incoming());
      allow update: if isSignedIn() && isValidId(id) && isValidVehicle(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['plate', 'internalNumber', 'capacity', 'status', 'workGroupId']);
      allow delete: if isSignedIn() && isValidId(id);
    }
    match /routes/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(id) && isValidRoute(incoming());
      allow update: if isSignedIn() && isValidId(id) && isValidRoute(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'code', 'operatingDays', 'origin', 'destination', 'estimatedHours', 'workGroupId', 'firstName', 'lastName']);
      allow delete: if isSignedIn() && isValidId(id);
    }
    match /assignments/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(id) && isValidAssignment(incoming());
      allow update: if isSignedIn() && isValidId(id) && isValidAssignment(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['routeId', 'vehicleId', 'employeeIds', 'date', 'status', 'incidents', 'workGroupId']);
      allow delete: if isSignedIn() && isValidId(id);
    }
    match /crews/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(id) && isValidCrew(incoming());
      allow update: if isSignedIn() && isValidId(id) && isValidCrew(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'driverId', 'assistantIds', 'workGroupId', 'firstName', 'lastName']);
      allow delete: if isSignedIn() && isValidId(id);
    }
  }
}
