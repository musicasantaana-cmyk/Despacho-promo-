{
  "entities": {
    "WorkGroup": {
      "title": "WorkGroup",
      "description": "A group of operators and vehicles.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 }
      },
      "required": ["name"]
    },
    "Employee": {
      "title": "Employee",
      "description": "An employee (driver, assistant, or coordinator).",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "firstName": { "type": "string", "maxLength": 50 },
        "lastName": { "type": "string", "maxLength": 50 },
        "role": { "type": "string", "enum": ["Conductor", "Ayudante", "Coordinador"] },
        "phone": { "type": "string", "maxLength": 20 },
        "workGroup": { "type": "string", "maxLength": 100 },
        "workGroupId": { "type": "string", "maxLength": 128 }
      },
      "required": ["name", "role", "phone"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "A vehicle in the fleet.",
      "type": "object",
      "properties": {
        "plate": { "type": "string", "maxLength": 20 },
        "internalNumber": { "type": "string", "maxLength": 50 },
        "capacity": { "type": "number" },
        "status": { "type": "string", "enum": ["Operativo", "Inoperativo"] },
        "workGroupId": { "type": "string", "maxLength": 128 }
      },
      "required": ["plate", "internalNumber", "capacity", "status"]
    },
    "RouteDef": {
      "title": "RouteDef",
      "description": "A predefined route.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "code": { "type": "string", "maxLength": 50 },
        "operatingDays": { "type": "array" },
        "origin": { "type": "string", "maxLength": 100 },
        "destination": { "type": "string", "maxLength": 100 },
        "estimatedHours": { "type": "number" },
        "workGroupId": { "type": "string", "maxLength": 128 },
        "routeMapPdfDataUrl": { "type": "string", "maxLength": 420000 },
        "routeMapPdfName": { "type": "string", "maxLength": 150 },
        "dischargeSheetPdfDataUrl": { "type": "string", "maxLength": 420000 },
        "dischargeSheetPdfName": { "type": "string", "maxLength": 150 }
      },
      "required": ["name", "code", "origin", "destination", "estimatedHours"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "A scheduled route for a vehicle and crew.",
      "type": "object",
      "properties": {
        "routeId": { "type": "string", "maxLength": 128 },
        "vehicleId": { "type": "string", "maxLength": 128 },
        "employeeIds": { "type": "array" },
        "date": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["Pendiente", "Salida de Base", "Inicio de Ruta", "Fin de Ruta", "Relleno", "Base", "Cancelado"] },
        "incidents": { "type": "array" },
        "workGroupId": { "type": "string", "maxLength": 128 }
      },
      "required": ["routeId", "vehicleId", "employeeIds", "date", "status"]
    },
    "CrewTemplate": {
      "title": "CrewTemplate",
      "description": "A predefined crew template.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "driverId": { "type": "string", "maxLength": 128 },
        "assistantIds": { "type": "array" },
        "workGroupId": { "type": "string", "maxLength": 128 }
      },
      "required": ["name", "driverId", "assistantIds"]
    },
    "AppUser": {
      "title": "AppUser",
      "description": "An application user with RBAC role and work group binding.",
      "type": "object",
      "properties": {
        "username": { "type": "string", "maxLength": 100 },
        "password": { "type": "string", "maxLength": 256 },
        "fullName": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["admin", "gestion", "supervisor", "conductor"] },
        "workGroupId": { "type": "string", "maxLength": 128 },
        "employeeId": { "type": "string", "maxLength": 128 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["username", "password", "role"]
    },
    "DriverShift": {
      "title": "DriverShift",
      "description": "Operational time control log recorded by a driver during a shift.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "maxLength": 20 },
        "workGroupId": { "type": "string", "maxLength": 128 },
        "workGroupName": { "type": "string", "maxLength": 100 },
        "driverId": { "type": "string", "maxLength": 128 },
        "driverName": { "type": "string", "maxLength": 120 },
        "vehicleNumber": { "type": "string", "maxLength": 50 },
        "vehicleId": { "type": "string", "maxLength": 128 },
        "routeId": { "type": "string", "maxLength": 128 },
        "routeCode": { "type": "string", "maxLength": 50 },
        "routeName": { "type": "string", "maxLength": 100 },
        "createdByUserId": { "type": "string", "maxLength": 128 },
        "createdByUsername": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["EN_TURNO", "EN_RUTA", "FIN_RUTA", "EN_BASE"] },
        "checklistConfirmed": { "type": "boolean" },
        "checklistConfirmedAt": { "type": "string", "maxLength": 50 },
        "odometer": { "type": "number" },
        "serviceTime": { "type": "string", "maxLength": 50 },
        "t1StartShiftAt": { "type": "string", "maxLength": 50 },
        "t2StartRouteAt": { "type": "string", "maxLength": 50 },
        "t3EndRouteAt": { "type": "string", "maxLength": 50 },
        "t4ArriveBaseAt": { "type": "string", "maxLength": 50 },
        "isPausedForRefill": { "type": "boolean" },
        "activeRefillId": { "type": "string", "maxLength": 128 },
        "pausedPhase": { "type": "string", "maxLength": 30 },
        "refillEvents": { "type": "array" },
        "isInBreakdown": { "type": "boolean" },
        "activeBreakdownId": { "type": "string", "maxLength": 128 },
        "breakdownEvents": { "type": "array" },
        "isSupportShift": { "type": "boolean" },
        "parentShiftId": { "type": "string", "maxLength": 128 },
        "parentRouteCode": { "type": "string", "maxLength": 50 },
        "parentRouteName": { "type": "string", "maxLength": 100 },
        "isPausedForSupport": { "type": "boolean" },
        "activeSupportShiftId": { "type": "string", "maxLength": 128 },
        "supportEvents": { "type": "array" },
        "supportTotalMins": { "type": "number" },
        "initialTransitMins": { "type": "number" },
        "routeExecutionMins": { "type": "number" },
        "routeExecutionNetMins": { "type": "number" },
        "returnTransitMins": { "type": "number" },
        "totalTransitMins": { "type": "number" },
        "totalOperationMins": { "type": "number" },
        "totalOperationNetMins": { "type": "number" },
        "refillTotalMins": { "type": "number" },
        "mechanicalBreakdownTotalMins": { "type": "number" },
        "weightTons": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["date", "workGroupId", "driverId", "driverName", "vehicleNumber", "createdByUserId", "status", "t1StartShiftAt"]
    },
    "BreakdownAuditLog": {
      "title": "BreakdownAuditLog",
      "description": "Audit log of mechanical breakdown alarms and user acknowledgements.",
      "type": "object",
      "properties": {
        "shiftId": { "type": "string", "maxLength": 128 },
        "breakdownId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 20 },
        "workGroupId": { "type": "string", "maxLength": 128 },
        "workGroupName": { "type": "string", "maxLength": 100 },
        "vehicleNumber": { "type": "string", "maxLength": 50 },
        "routeCode": { "type": "string", "maxLength": 50 },
        "routeName": { "type": "string", "maxLength": 100 },
        "driverId": { "type": "string", "maxLength": 128 },
        "driverName": { "type": "string", "maxLength": 120 },
        "incidentType": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 300 },
        "reportedAt": { "type": "string", "maxLength": 50 },
        "reportedByUserId": { "type": "string", "maxLength": 128 },
        "reportedByUsername": { "type": "string", "maxLength": 100 },
        "reportedByName": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["PENDIENTE", "ACEPTADA"] },
        "acknowledgedAt": { "type": "string", "maxLength": 50 },
        "acknowledgedByUserId": { "type": "string", "maxLength": 128 },
        "acknowledgedByUsername": { "type": "string", "maxLength": 100 },
        "acknowledgedByFullName": { "type": "string", "maxLength": 120 },
        "acknowledgedByRole": { "type": "string", "maxLength": 40 },
        "acknowledgementNotes": { "type": "string", "maxLength": 300 },
        "resolvedAt": { "type": "string", "maxLength": 50 },
        "resolvedByUserId": { "type": "string", "maxLength": 128 },
        "resolvedByUsername": { "type": "string", "maxLength": 100 },
        "resolvedReportedBy": { "type": "string", "maxLength": 150 },
        "resolutionNotes": { "type": "string", "maxLength": 300 },
        "durationMins": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["shiftId", "breakdownId", "date", "workGroupId", "vehicleNumber", "driverName", "incidentType", "reportedAt", "status"]
    }
  },
  "firestore": {
    "workGroups": {
      "schema": "WorkGroup",
      "description": "Stores work groups."
    },
    "employees": {
      "schema": "Employee",
      "description": "Stores employees."
    },
    "vehicles": {
      "schema": "Vehicle",
      "description": "Stores vehicles."
    },
    "routes": {
      "schema": "RouteDef",
      "description": "Stores route definitions."
    },
    "assignments": {
      "schema": "Assignment",
      "description": "Stores assignments."
    },
    "crews": {
      "schema": "CrewTemplate",
      "description": "Stores crew templates."
    },
    "app_users": {
      "schema": "AppUser",
      "description": "Stores authorized application users with RBAC roles and group assignments."
    },
    "driver_shifts": {
      "schema": "DriverShift",
      "description": "Stores driver operational time shifts, pauses, and mechanical breakdowns."
    },
    "breakdown_audit_logs": {
      "schema": "BreakdownAuditLog",
      "description": "Stores mechanical breakdown alarm audit logs and controller acknowledgements."
    }
  }
}
